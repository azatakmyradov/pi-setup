{
  "name": "pi-setup",
  "version": "1.0.0",
  "private": true,
  "description": "Personal extensions, prompts, and themes for Pi",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write \"*.{json,md}\" \"prompts/*.md\" \"themes/*.json\"",
    "format:check": "prettier --check \"*.{json,md}\" \"prompts/*.md\" \"themes/*.json\"",
    "test": "npm run test:ask-user && npm run test:background-terminals && npm run test:git-actions && npm run test:herdr && npm run test:review && npm run test:save-md && npm run test:scroll-on-send && npm run test:shared && npm run test:subagents && npm run test:summaries && npm run test:ui-customizations && npm run test:workflows && npm run test:web-tools",
    "test:background-terminals": "npm --prefix extensions/background-terminals test",
    "test:git-actions": "node --import tsx --test extensions/git-actions/*.test.ts",
    "test:herdr": "node --import tsx --test extensions/herdr-agent-name/*.test.ts extensions/herdr-agent-state/*.test.ts",
    "test:review": "node --import tsx --test extensions/review/*.test.ts",
    "test:scroll-on-send": "node --import tsx --test extensions/scroll-on-send/*.test.ts",
    "test:save-md": "npm --prefix extensions/save-md test",
    "test:shared": "node --import tsx --test extensions/shared/*.test.ts",
    "test:subagents": "npm --prefix extensions/subagents test",
    "test:summaries": "npm --prefix extensions/summaries test",
    "test:ui-customizations": "node --import tsx --test extensions/ui-customizations/*.test.ts",
    "test:workflows": "node --import tsx --test extensions/workflows/*.test.ts",
    "test:web-tools": "npm --prefix extensions/web-tools test",
    "test:ask-user": "npm --prefix extensions/ask-user test",
    "prepare": "vp config"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "acorn": "^8.17.0",
    "effect": "4.0.0-beta.98",
    "html-to-text": "^9.0.5",
    "linkedom": "^0.18.12",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.79.0",
    "@types/node": "^24.13.3",
    "@types/turndown": "^5.0.6",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite-plus": "0.2.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@earendil-works/pi-tui": "^0.99.1",
    "typebox": "*"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/ask-user/index.ts",
      "./extensions/background-terminals/index.ts",
      "./extensions/clear/index.ts",
      "./extensions/git-actions/index.ts",
      "./extensions/git-interceptor/index.ts",
      "./extensions/herdr-agent-state/index.ts",
      "./extensions/herdr-agent-name/index.ts",
      "./extensions/pi-skill-toggle/index.ts",
      "./extensions/review/index.ts",
      "./extensions/save-md/index.ts",
      "./extensions/scroll-on-send/index.ts",
      "./extensions/ui-customizations/index.ts",
      "./extensions/subagents/index.ts",
      "./extensions/summaries/index.ts",
      "./extensions/web-tools/index.ts",
      "./extensions/workflows/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
